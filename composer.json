{
  "name": "bwtech/files_primary_s3",
  "description": "S3 primary storage integration for owncloud.online. Modified by BW-Tech GmbH for owncloud.online (PHP 8.4 fork of owncloud/files_external_s3)",
  "require": {
    "php": ">=8.4",
    "aws/aws-sdk-php": "3.389.3"
  },
  "replace": {
    "guzzlehttp/guzzle": "7.15.1",
    "guzzlehttp/psr7": "2.13.0",
    "guzzlehttp/promises": "2.5.1",
    "psr/http-message": "2.0",
    "psr/http-client": "1.0.3",
    "psr/http-factory": "1.1.0"
  },
  "license": "GPL-2.0-only",
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": false,
    "platform": {
      "php": "8.4"
    },
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8",
    "roave/security-advisories": "dev-latest"
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": false
    }
  }
}
